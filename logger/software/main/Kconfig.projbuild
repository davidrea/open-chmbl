# Pin defaults below are the as-built logger PCB map, taken from the exported
# KiCad netlist of logger/hardware/logger.kicad_sch and tabulated in
# logger/hardware/BRINGUP.md §0. Do not take pin numbers from the older
# logger_sch_revA.pdf or from hardware/README.md — both are stale.
#
# Ranges are 0..48 throughout: the ESP32-S3's GPIO range. The retired
# ESP-WROVER-KIT (`esp32`) target is not supported — the pin map, the native-USB
# console and the LED set are all specific to this board — so the defaults here
# are unconditional rather than per-IDF_TARGET.

menu "CAN logger configuration"

    config LOGGER_BUTTON_GPIO
        int "Pushbutton GPIO number (UNUSED in this build)"
        range 0 48
        default 6
        help
            GPIO wired to the momentary pushbutton (BTN_SIG, J4 pin3, other side
            to GND). Active-low: R5 pulls the line up on-board, and pressing the
            button pulls it to GND.

            NOT USED BY THIS FIRMWARE. Recording is fully automatic, gated on
            the decoded engine kill switch (see "Automatic recording policy"
            below), so there is no start/stop button and no iot_button
            dependency. The symbol is retained rather than deleted because the
            pin is still routed on the board and documented in BRINGUP.md §0/§7,
            and a future build (a mark button, a safe-eject hold) would want it
            back here rather than rediscovered.

            The firmware configures nothing on this pin, so it floats at R5's
            pull-up.

    config LOGGER_CAN_TX_GPIO
        int "CAN (TWAI) TX GPIO number -> transceiver TXD"
        range 0 48
        default 21
        help
            GPIO routed to the TWAI transmit signal, wired to U2 (TCAN330) pin1
            TXD; R15 pulls it up to 3V3. Even in listen-only mode the driver
            still claims this pin.

    config LOGGER_CAN_RX_GPIO
        int "CAN (TWAI) RX GPIO number <- transceiver RXD"
        range 0 48
        default 47
        help
            GPIO routed to the TWAI receive signal, wired from U2 (TCAN330)
            pin4 RXD.

    config LOGGER_CAN_SILENT_GPIO
        int "CAN transceiver silent-mode (S) GPIO number"
        range 0 48
        default 35
        help
            The TCAN330's S (silent) pin, U2 pin8 — GPIO35, which is U1 pin 28.
            (Easy to transpose: the schematic pin number is 28, the GPIO is 35.)

            R16 (10K) pulls this net up to 3V3, and S high = silent: the
            transceiver receives but its driver is disabled, so it cannot put a
            dominant bit — not even an ACK — on the bus.

            At boot the firmware first reads this pin back as a HIGH-IMPEDANCE
            input with both internal pulls disabled — so a missing or unstuffed
            R16 shows up as a loud console warning instead of being masked — and
            THEN drives it high and leaves it there. Silence therefore does not
            depend on a single 10K resistor for a whole ride, while the board
            fault that would let the logger transmit onto a live bus is still
            detected.

            R16 covers the windows the firmware cannot: power-on, reset, and
            boot before app_main runs. A GPIO output latch holds its level
            through a firmware crash, so driving it does not weaken that.

            This is the hardware half of the project's golden rule (never
            disturb a live vehicle bus); CONFIG_LOGGER_CAN_LISTEN_ONLY below is
            the controller half.

            Driving this LOW (normal mode) is a deliberate, bench-only act — see
            BRINGUP.md §5.5, and only on an isolated bus. This firmware never
            does it.

    choice LOGGER_CAN_BITRATE
        prompt "CAN bit rate"
        default LOGGER_CAN_BITRATE_500K
        help
            Bit rate of the bus being logged. The reference Triumph bus is most
            likely 500 kbit/s (see docs/can-profiles.md); 250 kbit/s is the other
            common motorcycle rate.

        config LOGGER_CAN_BITRATE_125K
            bool "125 kbit/s"
        config LOGGER_CAN_BITRATE_250K
            bool "250 kbit/s"
        config LOGGER_CAN_BITRATE_500K
            bool "500 kbit/s"
        config LOGGER_CAN_BITRATE_1M
            bool "1 Mbit/s"
    endchoice

    config LOGGER_CAN_LISTEN_ONLY
        bool "Listen-only (silent) mode"
        default y
        help
            When enabled the TWAI controller runs in listen-only mode: it never
            acknowledges or transmits, so it cannot disturb a live vehicle bus
            (the project's golden rule). Disable only for a two-node bench where
            the single peer needs an ACK to keep transmitting — and note that
            the transceiver is still held silent by R16 regardless, so this
            alone will not produce bus traffic.

    config LOGGER_RX_QUEUE_LEN
        int "CAN RX-to-writer queue depth (frames)"
        range 64 8192
        default 1024
        help
            Depth of the queue buffering frames between the CAN receive task and
            the microSD writer task. Deeper tolerates longer SD write stalls at
            the cost of RAM. Overflows are counted and logged to the console.

            Frames reach this queue only while recording. The decode tap that
            feeds the DE-09 preview and the recording gate sees EVERY frame
            regardless — otherwise the gate could never turn recording on.

endmenu

menu "Automatic recording policy"

    # Recording is not operated by hand in this build. The gate is the decoded
    # `engine_cutoff` signal from the bike profile — 0x121 bit 30 set AND 0x121
    # byte 6 == 0x28 — where 1 means the kill switch is ASSERTED (STOP) and 0
    # means RUN. A new N.trc opens when the gate reads RUN, and closes on
    # RUN -> STOP or on bus silence. See logger_main.c and
    # logger/software/README.md.

    config LOGGER_BUS_SILENCE_MS
        int "Bus-silence timeout that closes the file (ms)"
        range 1500 60000
        default 3000
        help
            If no 0x121 frame carrying the kill-switch signal arrives for this
            long, the bus is treated as dead — which is what ignition-off looks
            like from the logger's side — and the open capture is closed.

            Must be comfortably ABOVE the decoder's own staleness window
            (CAN_DECODE_STALE_MS, 1000 ms). The gap between the two is
            deliberate hysteresis: a fresh reading (age <= 1000 ms) sets the
            gate, silence (age > this) closes the file, and in between the gate
            HOLDS. Without that gap a brief run of missed frames would chop one
            ride into two files.

    config LOGGER_FLUSH_INTERVAL_MS
        int "Durability flush interval (ms)"
        range 200 60000
        default 2000
        help
            How often the writer fflush()es and fsync()s the open .trc.

            There is no longer a button press to end a file cleanly, and the
            board can lose 12 V at any moment, so the 32 KB stdio buffer plus
            FATFS's in-RAM metadata is a real window of a ride to lose. fsync()
            is what makes FATFS commit the dirty sectors AND the directory
            entry, so the file ends up with a correct length and a reader can
            actually see the data.

            This BOUNDS the loss window; it does not replace the large write
            buffer, which is what keeps throughput ahead of a ~1500 frames/s
            bus. Smaller values lose less to a power cut and cost more card
            writes; a per-frame fsync would collapse throughput entirely, which
            is the problem the write buffer exists to solve.

    config LOGGER_FLUSH_KIB
        int "Durability flush byte budget (KiB)"
        range 1 1024
        default 64
        help
            The writer also flushes once this many KiB have been written since
            the last flush, whichever comes first. On a quiet bus the interval
            dominates; under a flood this caps the loss window by volume rather
            than by time.

            64 KiB is two .trc write buffers' worth — roughly half a second of
            the reference bus at its ~1500 frames/s peak.

endmenu

menu "microSD (SDMMC)"

    config LOGGER_SD_DET_GPIO
        int "Card-detect (DET_A) GPIO number"
        range 0 48
        default 8
        help
            J5 pin10, card-detect. Active-LOW: R17 pulls the line up, and a
            seated card pulls it to GND. Verified on hardware in BRINGUP.md §4.5.

            As with the button, the internal pull-up is left disabled so R17
            does the work and a missing R17 shows up as a fault rather than a
            false "no card" reading.

            SD operations are gated on this signal: the card is not mounted
            while it reads absent, and a recording will not start without one.

    config LOGGER_SD_CLK_GPIO
        int "SD CLK GPIO number"
        range 0 48
        default 9
        help
            J5 pin5, via series R12.

    config LOGGER_SD_CMD_GPIO
        int "SD CMD GPIO number"
        range 0 48
        default 10
        help
            J5 pin3; R9 pull-up on-board.

    config LOGGER_SD_D0_GPIO
        int "SD DAT0 GPIO number"
        range 0 48
        default 48
        help
            J5 pin7; R10 pull-up on-board.

    config LOGGER_SD_D1_GPIO
        int "SD DAT1 GPIO number"
        range 0 48
        default 17
        help
            J5 pin8; R11 pull-up on-board. Unused in 1-bit mode.

    config LOGGER_SD_D2_GPIO
        int "SD DAT2 GPIO number"
        range 0 48
        default 12
        help
            J5 pin1; R7 pull-up on-board. Unused in 1-bit mode.

    config LOGGER_SD_D3_GPIO
        int "SD DAT3 GPIO number"
        range 0 48
        default 11
        help
            J5 pin2; R8 pull-up on-board. Unused in 1-bit mode (the card still
            needs it pulled high, which R8 does).

    choice LOGGER_SD_BUS_WIDTH
        prompt "SDMMC bus width"
        default LOGGER_SD_BUS_WIDTH_4
        help
            4-bit is the intended production mode and the reason this board uses
            an S3. Select 1-bit to bisect data-line signal-integrity problems:
            BRINGUP.md §6.2 mounts 1-bit first, then §6.3 moves to 4-bit.

        config LOGGER_SD_BUS_WIDTH_1
            bool "1-bit (CLK/CMD/DAT0 only)"
        config LOGGER_SD_BUS_WIDTH_4
            bool "4-bit"
    endchoice

endmenu

menu "Indicators"

    # Every LED on this board is active-high: the GPIO sources into the LED
    # (D5/D6, via R20/R21) or into Q1's gate (remote LED). There is no
    # active-low option because there is no active-low LED on the board.
    #
    # This build has NO LED status indication for logging. The remote LED is the
    # DE-09 brake-light preview and nothing else — sharing it with logger status
    # would make the FSM decision unreadable, which is the point of the build —
    # and the onboard D5/D6 are inside the sealed enclosure and invisible on a
    # ride. Recording is silent; the console log is the diagnostic surface.

    config LOGGER_LED_EXT_GPIO
        int "Remote brake-preview LED GPIO number"
        range 0 48
        default 18
        help
            Drives Q1 (2N7002K) through R3, low-side switching the remote LED on
            J4 pin2; R18 holds the gate down. High = LED lit
            (BRINGUP.md §0/§7.2).

            In this firmware the LED shows the DE-09 brake-light decision and
            nothing else: ON whenever the state machine is in BRAKING or
            STOPPED, i.e. whenever this firmware would be commanding ST_BRAKE
            over ESP-NOW — which it does not transmit in this build. A steady
            level, no blinking, no brightness control.

    config LOGGER_FAULT_LED_ENABLE
        bool "Blink an onboard LED on a fatal error"
        default n
        help
            Off by default, and intended for bench work only.

            D5/D6 sit on the PCB inside the sealed enclosure, so on a ride they
            tell nobody anything. With this enabled, a latched fatal error (no
            card, mount failure, CAN start failure, transceiver not silent)
            blinks the LED below at 2 Hz. With it disabled the firmware touches
            neither onboard LED at all and both pins stay free.

            This is the ONLY onboard indication in this build. There is
            deliberately no recording-state, bus-liveness or card-activity
            pattern — see the menu comment above.

    config LOGGER_FAULT_LED_GPIO
        int "Fatal-error LED GPIO number"
        range 0 48
        default 1
        depends on LOGGER_FAULT_LED_ENABLE
        help
            D6, red, via R21, active-high (BRINGUP.md §0/§4.1). Set to 2 to use
            D5 (green) instead.

endmenu
