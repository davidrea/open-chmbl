# Default sdkconfig values applied on a fresh build (committed; the generated
# `sdkconfig` is not). Override per-board with `idf.py menuconfig`.
#
# Target is the ESP32-S3-WROOM-1-N4 on the custom logger PCB
# (logger/hardware/logger.kicad_sch). Select it with
# `idf.py set-target esp32s3` (or the `target` input of the CI action).
# Target-shaped options live in sdkconfig.defaults.esp32s3.
#
# The retired ESP-WROVER-KIT (`esp32`) is no longer supported: the pin map, the
# console transport and the indicator set are all specific to the logger PCB.

# --- Flash: U1 is an ESP32-S3-WROOM-1-N4 (schematic + BOM, LCSC C2913197):
#     4 MB flash, NO PSRAM. Verified on the bench -- flash_id reports JEDEC
#     c8/4016 = GigaDevice GD25Q32, 32 Mbit.
#
#     Build this at 8 MB by mistake and the app boot-loops before app_main with
#     "Detected size(4096k) smaller than the size in the binary image header" ->
#     assert failed at startup_funcs.c:114. Note the bootloader still prints
#     "SPI Flash Size : 8MB" in that case -- that's the image header being
#     echoed, not a probe of the fitted part.
#
#     Kept in the target-agnostic file on purpose: this describes the fitted
#     module, and getting it wrong bricks the boot, so it must not depend on
#     the per-target file being picked up. ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Partition table: single app, no OTA, sized against the 4 MB part. The
#     default "single app" layout caps the factory partition at 1 MB, which is
#     tight once FATFS + SDMMC + TWAI are linked in; the _LARGE variant gives
#     ~1.5 MB of headroom. There is no OTA on this board. ---
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- NOTE: no CONFIG_SPIRAM anywhere in these files, deliberately. The -N4
#     module has no PSRAM; the option must be absent (not merely =n). ---

# --- FAT filesystem: allow long filenames so the microSD's existing files list
#     cleanly even though our own logs are short 8.3 names (N.trc) ---
CONFIG_FATFS_LFN_STACK=y

# --- Smaller, quieter default log level for shipping firmware. Note that the
#     operations log and the DE-09 transition log both go out at INFO, and in
#     this build the console is the ONLY diagnostic surface (recording is
#     silent, the remote LED is the brake-light preview) -- do not raise this
#     above INFO for a ride. ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
